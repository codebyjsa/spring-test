pipeline {
    agent any
    stages {
        stage('Checkout Code') {
            steps {
                echo 'Starting checkout...'
                checkout scm
                sh 'pwd'
                sh 'ls -la'
            }
        }
        stage('Build Dependency - jm-common') {
            steps {
                echo 'Installing jm-common dependency...'
                withEnv([
                    "JAVA_HOME=${tool 'jdk-21'}",
                    "MAVEN_HOME=${tool 'maven3'}",
                    "PATH=${tool 'jdk-21'}/bin:${env.PATH}"
                ]) {
                    // Assuming jm-common source is checked out in a subdirectory 'jm-common'
                    dir('jm-common') {
                        sh "${MAVEN_HOME}/bin/mvn clean install -DskipTests"
                    }
                }
            }
        }
        stage('Set Environment') {
            steps {
                withEnv([
                    "JAVA_HOME=${tool 'jdk-21'}",
                    "MAVEN_HOME=${tool 'maven3'}",
                    "PATH=${tool 'jdk-21'}/bin:${env.PATH}",
                    "GITHUB_TOKEN=${credentials('jenkins-cicd')}",
                    "REPO_OWNER=codebyjsa",
                    "REPO_NAME=spring-test"
                ]) {
                    echo "Environment variables set"
                    echo "JAVA_HOME: ${env.JAVA_HOME}"
                    echo "MAVEN_HOME: ${env.MAVEN_HOME}"
                }
            }
        }
        stage('Build') {
            steps {
                echo 'Starting build...'
                withEnv([
                    "JAVA_HOME=${tool 'jdk-21'}",
                    "MAVEN_HOME=${tool 'maven3'}",
                    "PATH=${tool 'jdk-21'}/bin:${env.PATH}"
                ]) {
                    sh "${MAVEN_HOME}/bin/mvn clean install -DskipTests"
                    echo 'Build completed'
                }
            }
        }
        // Remaining stages...
    }
    post {
        always {
            echo 'Cleaning up workspace...'
            deleteDir()
        }
    }
}
